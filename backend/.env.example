PROJECT_NAME="Website Mua Bán Ô Tô Cũ Tích Hợp AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/used_cars_db"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/used_cars_db"

# Security & JWT
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Third-party Integrations
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Initial Seed Admin
INITIAL_ADMIN_EMAIL="admin@otocu.vn"
INITIAL_ADMIN_PASSWORD="Admin@123456"

# Email & SMTP Settings
EMAILS_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_TLS=true
EMAILS_FROM_NAME="AuraAuto Việt Nam"
EMAILS_FROM_EMAIL="your-email@gmail.com"
FRONTEND_URL="http://localhost:3000"

# VNPay Payment Gateway (Sandbox)
VNP_TMN_CODE="your-vnp-tmn-code"
VNP_HASH_SECRET="your-vnp-hash-secret"
VNP_API_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="https://auraauto.onrender.com/api/v1/payments/vnpay/return"
PUBLIC_API_URL="https://auraauto.onrender.com"
FRONTEND_PAYMENT_RESULT_URL="http://localhost:3000/thanh-toan/ket-qua"
